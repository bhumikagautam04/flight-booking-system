<html>
    <head>
        <link rel="stylesheet" href="/stylesheets/flight.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@100..900&family=Black+Ops+One&family=Oswald:wght@200..700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@100..900&family=Bitter:ital,wght@0,100..900;1,100..900&family=Black+Ops+One&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
   <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="/javascripts/flight_data.js"></script>
    </head>
<div class="maincontainer">
        <div class="box_display">    
            <div class="container-fluid p=0">
                <div class="row">
                    <div class="col-md-12">
                       <div style="display: flex;flex-direction:center;width:100%; align-items:center; justify-content:space-between;padding:5px;border-radius:0px;background-color:black;">
                        <div style="display:flex; align-items:center; width:100%;">
                        <span><img src="/images/airplane.png" style="width:40px; height:40px;"></span> 
                        <span class="textstyle">SkyNova Airlines</span> 
                        </div>
                        <a href="/flight/flight_interface" style="cursor:pointer;">
                        <div >
                        <span><img src="/images/airplane-ticket.png" style="width:40px; height:40px;"></span>  
                        </div> 
                        </a> 
                        </div>             
                    </div>
                    </div>  

                    <table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">Flight ID</th>
      <th scope="col">Flight Name</th>
      <th scope="col">Flight Type</th>
      <th scope="col">Flight Seat</th>
      <th scope="col">Days</th>
      <th scope="col">Source City</th>
      <th scope="col">Departure Time</Time></th>
      <th scope="col">Destination City</th>
      <th scope="col">Arrival Time</th>
      <th scope="col">Company</th>
      <th scope="col">Logo</th>
      <th scope="col">Update</th>
    </tr>
  </thead>
  <tbody>
    <% data.map((item)=>{%>
    
    <tr>
      <td><%= item.flight_id %></td>
      <td><%= item.flight_name %></td>
      <td><%= item.flight_type %></td>
      <td><%= item.flight_seat %></td>
      <td><%= item.days %></td>
      <td><%= item.source_city %></td>
      <td><%= item.departure_time %></td>
      <td><%= item.destination_city %></td>
      <td><%= item.arrival_time %></td>
      <td><%= item.company %></td>
      <td><a href="/flight/show_picture/<%= item.flight_id %>/<%= item.flight_name %>/<%= item.logo %>"><img src="/images/<%= item.logo %>" style="width:40px; height:40px; border-radius:5px;"></a></td>
    
     <td style="cursor:pointer,"><a href ="/flight/edit_delete/<%= item.flight_id %>" style="color:black";>Edit/Delete</a></td>
     
    </tr>
    
     
    <% }) %>
  </tbody>
</table>
</body>
</html>