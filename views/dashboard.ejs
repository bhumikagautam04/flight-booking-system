<html>
<head>
    <link rel="stylesheet" href="/stylesheets/flight.css">
    <link rel="stylesheet" href="/stylesheets/dashboard.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@100..900&family=Bitter:ital,wght@0,100..900;1,100..900&family=Black+Ops+One&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&family=Lobster&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Stack+Sans+Notch:wght@200..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="dashboard-page">

<div class="dashboardmaincontainer">

    <!-- ✅ APPBAR (TOP NAVBAR) -->
    <div class="appbar">

        <div class="textstyle3">
            ✈ Flight Management System
        </div>

        <div style="display:flex;align-items:center;gap:10px;">
            <img src="/images/<%= data.picture %>" style="width:40px;height:40px;border-radius:5px;">
            <span style="font-size:20px;color:#f8fafc;"><%= data.adminname %></span>
        </div>

    </div>

    <!-- ✅ MAIN CONTENT AREA -->
    <div class="container-fluid p-0">

        <div class="row g-0">

            <!-- SIDEBAR -->
            <div class="col-md-2">
                <div class="dashboardbox ">
            <a href="/admin/dashboard" style="text-decoration:none; display:block; color:inherit;">
                <div class="sidebar-link">
            <img src="/images/layout.png" width="35px" height="35px"/>
            <span>
                Dashboard
            </span>
        </div>
        </a>
        <div class="dashboard-divider"></div>
          <a href="/flight/flight_interface" style="text-decoration:none; display:block; color:inherit;" target="mw">
            <div class="sidebar-link">
                <img src="/images/travel.png" width="35px" height="35px"/>
                <span>
                    New Flights
                </span>
            </div>
          </a>
          <a href="/flight/fetch_all_flight" style="text-decoration:none; display:block; color:inherit;" target="mw">
         <div class="sidebar-link">
            <img src="/images/flight.png" width="35px" height="35px"/>
            <span>
                Flight List
            </span>
        </div>
    </a>
    <a href="/flight/search_by_id" style="text-decoration:none; display:block; color:inherit;" target="mw">
         <div class="sidebar-link">
            <img src="/images/airplane.png" width="35px" height="35px"/>
            <span>
                Search Flights
            </span>
        </div>
    </a>
    <a href="/admin/logout" style="text-decoration:none; display:block; color:inherit;" target="_top">
         <div class="sidebar-link">
            <img src="/images/logout.png" width="35px" height="35px"/>
            <span>
                Logout
            </span>
        </div>
    </a>
    
       </div>

        </div>
        <div class="col-md-10" style="padding:13px;">
            <div class="dashboard-panel dashboard-panel--compact">
                <div class="dashboard-panel-header">
                    <div>
                        <h2>Flight Dashboard</h2>
                        <p>Track all flights, routes, and airline operations at a glance.</p>
                    </div>
                </div>
                <div class="dashboard-summary-grid">
                    <div class="dashboard-summary-card">
                        <div class="dashboard-card-icon">✈️</div>
                        <div class="dashboard-card-body">
                            <span>Total Flights</span>
                            <strong><%= stats && stats.flights ? stats.flights : 0 %></strong>
                        </div>
                    </div>
                    <div class="dashboard-summary-card">
                        <div class="dashboard-card-icon">🏙️</div>
                        <div class="dashboard-card-body">
                            <span>Source / Destination Cities</span>
                            <strong><%= stats && stats.cities ? stats.cities : 0 %></strong>
                        </div>
                    </div>
                    <div class="dashboard-summary-card">
                        <div class="dashboard-card-icon">🏢</div>
                        <div class="dashboard-card-body">
                            <span>Unique Airlines</span>
                            <strong><%= stats && stats.companies ? stats.companies : 0 %></strong>
                        </div>
                    </div>
                </div>
                <iframe frameborder="0" width="100%" height="640" name="mw" class="dashboard-frame"></iframe>
            </div>
        </div>
                </div>
            </div>

           
        

    </div>



</body>
</html>