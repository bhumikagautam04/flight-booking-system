<html>
    <head>
        <link rel="stylesheet" href="/stylesheets/flight.css">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@100..900&family=Black+Ops+One&family=Oswald:wght@200..700&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bitcount+Single:wght@100..900&family=Bitter:ital,wght@0,100..900;1,100..900&family=Black+Ops+One&family=Noto+Sans:ital,wght@0,100..900;1,100..900&family=Oswald:wght@200..700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
   <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="/javascripts/flight_data.js"></script>
    </head>
      <form action="/flight/flight_edit_delete"
      method="post">
    <body>
<div class="maincontainer">
        <div class="box">    
            <div class="container-fluid p=0">
                <div class="row">
                    <div class="col-md-12">
                       <div style="display: flex;flex-direction:center;width:100%; align-items:center; justify-content:space-between;padding:5px;border-radius: 15px;background-color:black;">
                        <div style="display:flex; align-items:center; width:100%;">
                        <span><img src="/images/airplane.png" style="width:40px; height:40px;"></span> 
                        <span class="textstyle">Modify Flight Details</span> 
                         </div>
                         <a href="/flight/fetch_all_flight">
                        <div >
                        <span><img src="/images/airplane-ticket.png" style="width:40px; height:40px;"></span>  
                        </div> 
                        </a> 
                        </div>             
                    </div>
                    </div>
                    <input type="hidden" name="flight_id" value="<%= data.flight_id %>"/>
                    <div class="row">
                        <div class="col-md-6" style="margin-top:20px;">
                            <label class="form-label text">Flight Name</label>
                           <div class="form-floating">
                            <input class="form-control" type="text" placeholder=" " name="flightname" value="<%=data.flight_name %>"style="border-radius:15px;">
                            <label for="flightname">Flight Name</label>
                           </div>
                        </div>
                        <div class="col-md-6" style="margin-top:20px;">
                             <label class="form-label text">Flight Type</label>
                            <div class="form-floating">
  <select class="form-select form-control" id="flighttype" name="flighttype" aria-label="Choose Type....." style="border-radius:15px;">
    <option selected value="<%= data.flight_type %>"><%= data.flight_type %></option>
  </select>
  <label for="Choose Type">Choose Type...</label>
</div>
         </div>
 </div>
<div class="row">
    <div class="col-md-4" style="margin-top:20px;">
                                    <label class="form-label text" >Flight Seats</label>
                           <div class="form-floating">
                            <input class="form-control" type="text" placeholder=" " name="flightseats" value="<%= data.flight_seat %>"style="border-radius:15px;">
                            <label for="flightseats">Flight Seats</label>
</div>
</div>
    <div class="col-md-8" style="margin-top:20px;">
        <label class="form-label text d-block">Select Days</label>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
  <input class="form-check-input" type="checkbox" name="days[]" value="Mon" id="mon">
  <label class="form-check-label" for="Mon">
   Mon
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
  <input class="form-check-input" type="checkbox" name="days[]" value="Tue" id="tue">
  <label class="form-check-label" for="tue">
   Tue
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
 <input class="form-check-input" type="checkbox" name="days[]" value="Wed" id="wed">
  <label class="form-check-label" for="Wed">
   Wed
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
<input class="form-check-input" type="checkbox" name="days[]" value="Thu" id="thu">
  <label class="form-check-label" for="thu">
   Thu
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
  <input class="form-check-input" type="checkbox" name="days[]" value="Fri" id="fri">
  <label class="form-check-label" for="fri">
   Fri
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
  <input class="form-check-input" type="checkbox" name="days[]" value="Sat" id="sat">
  <label class="form-check-label" for="sat">
   Sat
  </label>
</div>
<div class="form-check form-check-inline" style="transform: scale(1.1);">
 <input class="form-check-input" type="checkbox" name="days[]" value="Sun" id="sun">
  <label class="form-check-label" for="sun">
   Sun
  </label>
  </div>
  </div>  
    <div class="row">
 <div class="col-md-3" style="margin-top:20px;">
<label class="form-label text" >Source City</label>
 <select class="form-select form-control" id="sourcecity" name="sourcecity" aria-label="Select Source CIty" style="border-radius:15px;">
    <option selected value="<%= data.source_city %>"> <%= data.source_city %></option>
  </select>
  </div>
           <div class="col-md-3" style="margin-top:20px;">
            <label class="form-label text" >Departure Time</label>
     <input type="time" class="form-control" placeholder="Departure Time" name="departuretime"value="<%= data.departure_time %>" style="border-radius:15px;"/>
        </div> 
           <div class="col-md-3" style="margin-top:20px;">
<label class="form-label text" >Destination City</label>
 <select class="form-select form-control" id="destinationcity" name="destinationcity" aria-label="Select Destination CIty" style="border-radius:15px;">
    <option selected value="<%= data.destination_city %>"><%= data.destination_city %></option>
  </select>
</div> 
    <div class="col-md-3" style="margin-top:20px;">
         <label class="form-label text" >Arrival Time</label>
     <input type="time" class="form-control" placeholder="Arrival Time" name="arrivaltime" value="<%= data.arrival_time %>" style="border-radius:15px;"/>
        </div>
        <datalist id="cityOptions"></datalist>
        <div class="row">
                        <div class="col-md-6" style="margin-top:20px;">
                            <label class="form-label text" >Company</label>
                           <div class="form-floating">
                            <input class="form-control" type="text" placeholder=" " name="company" value="<%= data.company %>" style="border-radius:15px;">
                            <label for="company">Company</label>
                           </div>
                           </div>
                            <div class="col-md-6" style="margin-top:20px;"> 
                                 <label class="form-label text" >Logo</label> 
                                 <div class="form-floating">   
                            <input class="form-control" type="file" placeholder="choose image" id="picture" name="picture" style="border-radius:15px; box-shadow:5px 5px 10px black;border-color:black;"/>
                        <label for="picture">Upload Logo</label>   
                        </div>
                            </div>
                      </div>
                      <div class="row">
                        <div class="col-md-6" style="margin-top:20px;">
                    <input class="btn btn-primary" type="submit" name="btn" value="Edit" style="border-radius:15px;width:100%;background-color:black;border-color:black;">
                        </div>
                        <div class="col-md-6" style="margin-top:20px;">
                    <input class="btn btn-primary" type="submit" name="btn" value="Delete" style="border-radius:15px;width:100%;background-color:black;border-color:black;">
                        </div>
                      </div>
                      <div class="row">
                       
                      </div>
    </div>   
</div>
            </div>
            
        </div>
    </div>
  </form>
</html>