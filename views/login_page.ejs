<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet" href="/stylesheets/flight.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<title>Flight Login</title>

</head>
<body>
<div class="main-container">

    <!-- Left Panel -->

    <div class="left-panel">
    <div class="overlay">
        <div class="brand-content">
            <h1>SkyNova Airlines</h1>
            <p>
                Book flights seamlessly and manage your journeys with ease.
            </p>
        </div>
    </div>
</div>

    <!-- Right Panel -->

    <div class="right-panel">

        <div class="login-box">

           
          <span class="textstyle2">Welcome Back</span> 
            <p class="subtitle">
                Login to continue your journey
            </p>

            <% if(typeof message !== 'undefined' && message){ %>

                <div class="alert alert-danger">
                    <%= message %>
                </div>

            <% } %>

            <form action="/admin/chk_login" method="post">

                <div class="mb-3">

                    <label>Email Address</label>

                    <input
                    type="email"
                    name="emailid"
                    class="form-control custom-input"
                    placeholder="Enter Email" autocomplete="new-password">

                </div>

                <div class="mb-4">

                    <label>Password</label>

                    <input
                    type="password"
                    name="pwd"
                    class="form-control custom-input"
                    placeholder="Enter Password" autocomplete="new-password">

                </div>

                <div class="d-flex justify-content-between mb-4">

                    <div>

                        <input type="checkbox">

                        Remember Me

                    </div>

  

                </div>

                <button
                type="submit"
                class="btn login-btn w-100" style="background-color: black ;color:white";>

                    Login

                </button>

            </form>

        </div>

    </div>

</div>
</form>
</body>
</html>