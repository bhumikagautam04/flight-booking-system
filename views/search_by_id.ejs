    </head>
    <body>
      <form action="/flight/fetch_by_id" method="post">
<div class="maincontainer">
        <div class="box">    
            <div class="container-fluid p=0">
                <div class="row">
                    <div class="col-md-12">
                       <div style="display: flex;flex-direction:center;width:100%; align-items:center; justify-content:space-between;padding:5px;border-radius: 15px;background-color:black;">
                        <div style="display:flex; align-items:center; width:100%;">
                        <span><img src="/images/delayed.png" style="width:40px; height:40px;"></span> 
                        <span class="textstyle">SkyNova Airlines</span> 
                        </div>
                        <a href="/flight/fetch_all_flight" style="cursor: pointer;">
                        <div >
                        <span><img src="/images/airplane-ticket.png" style="width:40px; height:40px;"></span>  
                        </div>  
                        </a>
                        </div>             
                    </div>
                    </div>
   
<div class="row">
    <div class="col-md-12" style="margin-top:20px;">
                           <div class="form-floating">
                            <input class="form-control" type="text" placeholder=" " name="flight_id" style="border-radius:15px;" required>
                            <label for="flight_id">Enter Flight ID Which You Want to Search</label>
</div>
</div>
     
                      <div class="row">
                        <div class="col-md-6" style="margin-top:20px;">
                    <input class="btn btn-primary" type="submit" value="Submit" style="border-radius:15px;width:100%;background-color:black;border-color:black;">
                        </div>
                        <div class="col-md-6" style="margin-top:20px;">
                    <input class="btn btn-primary" type="reset" value="Reset" style="border-radius:15px;width:100%;background-color:black;border-color:black;">
                        </div>
                      </div>
                      </div>
    </div>   
</div>
            </div>
            
        </div>
    </div>
  </form>
